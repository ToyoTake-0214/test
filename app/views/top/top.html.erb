<!DOCTYPE html>
<html>
    <title>Simple Marker</title>

    <style>
    #map {
      height: 500px;
      width: 100%;
    }
  </style>

    <script>
    let map

      function initMap(){
        map = new google.maps.Map(document.getElementById('map'), {
            center: {lat: 35.68123620000001, lng:139.7671248},
            zoom: 12,
        });

      <% Event.where.not(latitude: nil, longitude: nil).each do |m| %>
          (function(){
          var contentString = "住所：<%= m.address %>"; 

          var marker = new google.maps.Marker({
              position:{lat: <%= m.latitude %>, lng: <%= m.longitude %>},
              map: map,
              title: contentString
          });

          })();
      <% end %>

      }


    </script>

    <div id="map"></div>
    <%= link_to "新規登録" ,new_event_path %>

    
    <script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_MAP_API_KEY'] %>&callback=initMap" async defer>
    </script>

</html>
